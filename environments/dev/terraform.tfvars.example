# Development Environment - Example Terraform Variables
# Copy this file to terraform.tfvars and fill in actual values
# IMPORTANT: Do NOT commit actual credentials. This is a template file.

# Azure Service Principal Credentials
subscription_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
client_id       = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
client_secret   = "your-service-principal-secret-here"
tenant_id       = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Environment and Location
environment = "dev"
location    = "East US"

# Resource Group
resource_group_name = "rg-3tier-app-dev"

# Network Configuration
vnet_name              = "vnet-dev"
vnet_address_space     = ["10.0.0.0/16"]
subnet_name            = "subnet-dev"
subnet_address_prefix  = "10.0.1.0/24"

# Key Vault (must be globally unique, 3-24 characters)
keyvault_name = "kv3tierapp-dev"

# Container Registry (must be lowercase alphanumeric, globally unique)
acr_name = "acr3tierappdev"

# AKS Cluster
aks_cluster_name = "aks-3tier-dev"
aks_dns_prefix   = "aks3tierdev"
kubernetes_version = "1.27"

# MySQL Database
mysql_server_name    = "mysql-3tier-dev"
mysql_database_name  = "appdb"
mysql_admin_username = "azureuser"
# Password must be 8-128 characters with uppercase, lowercase, digit, special character
mysql_admin_password = "P@ssw0rd1234567890"

# Storage Account (3-24 lowercase alphanumeric, globally unique)
storage_account_name = "st3tierappdev"

# Function App
function_app_name = "func-3tier-dev"

# App Service
app_service_plan_name = "asp-3tier-dev"
app_service_name      = "app-3tier-dev"

# Application Gateway Configuration
app_gateway_name           = "appgw-3tier-dev"
app_gateway_sku_name       = "Standard_v2"
app_gateway_sku_tier       = "Standard_v2"
app_gateway_capacity       = 1
appgw_private_ip_address   = "10.0.2.5"
app_gateway_host_names     = ["myapp.com", "www.myapp.com"]
app_gateway_path_based_routing = true
enable_waf                 = false
waf_mode                   = "Detection"
# certificate_secret_id = "https://kvname.vault.azure.net/secrets/cert-name/version"  # Optional: from Key Vault

# Load Balancer Configuration
load_balancer_name = "lb-3tier-dev"
load_balancer_sku  = "Standard"

# Monitoring (optional - uncomment if using Log Analytics)
# log_analytics_workspace_id = "/subscriptions/xxx/resourcegroups/xxx/providers/microsoft.operationalinsights/workspaces/xxx"
