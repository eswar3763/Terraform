# Staging Environment - Example Terraform Variables
# Copy this file to terraform.tfvars and fill in actual values
# IMPORTANT: Do NOT commit actual credentials. This is a template file.

# Azure Service Principal Credentials
subscription_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
client_id       = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
client_secret   = "your-service-principal-secret-here"
tenant_id       = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Environment and Location
environment = "staging"
location    = "East US"

# Resource Group
resource_group_name = "rg-3tier-app-staging"

# Network Configuration
vnet_name              = "vnet-staging"
vnet_address_space     = ["10.1.0.0/16"]
subnet_name            = "subnet-staging"
subnet_address_prefix  = "10.1.1.0/24"

# Key Vault
keyvault_name = "kv3tierapp-staging"

# Container Registry
acr_name = "acr3tierappstaging"

# AKS Cluster
aks_cluster_name = "aks-3tier-staging"
aks_dns_prefix   = "aks3tierstaging"
kubernetes_version = "1.27"

# MySQL Database
mysql_server_name = "mysql-3tier-staging"
mysql_database_name = "appdb"
mysql_admin_username = "azureuser"
mysql_admin_password = "P@ssw0rd1234567890"

# Storage Account
storage_account_name = "st3tierappstaging"

# Function App
function_app_name = "func-3tier-staging"

# App Service
app_service_plan_name = "asp-3tier-staging"
app_service_name      = "app-3tier-staging"

# Application Gateway Configuration (Staging with WAF Detection mode)
app_gateway_name           = "appgw-3tier-staging"
app_gateway_sku_name       = "Standard_v2"
app_gateway_sku_tier       = "Standard_v2"
app_gateway_capacity       = 2
appgw_private_ip_address   = "10.1.2.5"
app_gateway_host_names     = ["myapp.com", "www.myapp.com"]
app_gateway_path_based_routing = true
enable_waf                 = true
waf_mode                   = "Detection"  # Detection mode for staging
# certificate_secret_id = "https://kvname.vault.azure.net/secrets/cert-name/version"

# Load Balancer Configuration
load_balancer_name = "lb-3tier-staging"
load_balancer_sku  = "Standard"

# Monitoring (optional)
# log_analytics_workspace_id = "/subscriptions/xxx/resourcegroups/xxx/providers/microsoft.operationalinsights/workspaces/xxx"
